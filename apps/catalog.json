      "exec": [
        "bash",
        "-c",
        "agent=$(omarchy-default-agent 2>/dev/null); command -v \"$agent\" >/dev/null || agent=$(\"$OMARCHY_TV_ROOT/bin/omarchy-tv-ask\" agent); cd ~; exec omarchy-agent --inline ${agent:+--agent \"$agent\"}"
